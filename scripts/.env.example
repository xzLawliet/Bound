NEAR_NETWORK=testnet
# Active targets. This file does not create accounts or deploy code.
# Owner xzlawliet.testnet exists (previously bound-aoyamari.testnet). Faucet HCTPTiMUQhCzHKLKYKspcz7aTgSjwgxspSpq7sDbVEAA is 10 NEAR account creation, not a contract deploy. demo-agent.mjs does not read an owner variable.
# guardian.xzlawliet.testnet (previously guardian.bound-aoyamari.testnet) exists with 5 NEAR. No code and no policy are recorded. Creation tx omitted.
# agent.xzlawliet.testnet (previously agent.bound-aoyamari.testnet) and vendor.xzlawliet.testnet (previously vendor.bound-aoyamari.testnet) are not recorded yet.
# Intended limits after init, not a live get_policy: max 0.25 NEAR (AMOUNT_OVER_MAX is 0.3), daily 0.5 NEAR.
GUARDIAN_CONTRACT=guardian.xzlawliet.testnet
AGENT_ACCOUNT_ID=agent.xzlawliet.testnet
# Use AGENT_KEY_FILE or supply in ignored .env.local
VENDOR_ACCOUNT_ID=vendor.xzlawliet.testnet
# Unknown receiver. Unchanged. demo-agent.mjs falls back to this same id when the variable is unset.
SCAM_ACCOUNT_ID=near-examples.testnet
AMOUNT_OK=100000000000000000000000
AMOUNT_OVER_MAX=300000000000000000000000

# NEAR_RPC_URL=https://rpc.testnet.near.org
