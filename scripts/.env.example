NEAR_NETWORK=testnet
# Active targets. Owner xzlawliet.testnet is not read by demo-agent.mjs.
# agent.xzlawliet.testnet is unused (gas allowance 0, no payments). Do not set it here.
# Public function-call key ed25519:AjkYUs1vp7MvfwJmXHs1vaYfYcMT7uEK6EhLU5uksE2c
# method spend, receiver guardian.xzlawliet.testnet, initial gas allowance exactly 0.25 NEAR.
# That allowance is gas budget, not the treasury cap. Private key only in ignored .env.local.
# Limits: max 0.25 NEAR (AMOUNT_OVER_MAX is 0.3), daily 0.5 NEAR.
GUARDIAN_CONTRACT=guardian.xzlawliet.testnet
AGENT_ACCOUNT_ID=agent2.xzlawliet.testnet
# Use AGENT_KEY_FILE or supply in ignored .env.local
VENDOR_ACCOUNT_ID=vendor.xzlawliet.testnet
# Unknown receiver. Unchanged. demo-agent.mjs falls back to this same id when the variable is unset.
SCAM_ACCOUNT_ID=near-examples.testnet
AMOUNT_OK=100000000000000000000000
AMOUNT_OVER_MAX=300000000000000000000000

# NEAR_RPC_URL=https://rpc.testnet.near.org
